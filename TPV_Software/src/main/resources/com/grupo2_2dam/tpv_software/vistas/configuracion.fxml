<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import io.github.palexdev.mfxcore.controls.Label?>
<VBox alignment="CENTER" prefHeight="500.0" prefWidth="500.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo2_2dam.tpv_software.controladores.ConfiguracionControlador"
      >
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título -->
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Configurar servidor" />

    <Separator />

    <!-- Método de conexión -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label style="-fx-font-weight: bold;" text="Conectar por:" />
        <HBox alignment="CENTER" spacing="20.0">
            <MFXRadioButton fx:id="rbHost" selected="true" text="Host">
                <toggleGroup>
                    <ToggleGroup fx:id="conexionGroup" />
                </toggleGroup>
            </MFXRadioButton>
            <MFXRadioButton fx:id="rbURL" text="URL" toggleGroup="$conexionGroup" />
        </HBox>
    </HBox>

    <!-- Opciones para Host (Host + Puerto) -->
    <VBox fx:id="hostOptions" alignment="CENTER" spacing="10.0">
        <HBox alignment="CENTER" spacing="10.0">
            <MFXTextField fx:id="hostField"/>
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <MFXTextField fx:id="portField" />
        </HBox>
    </VBox>

    <!-- Opciones para URL (campo URL) -->
    <VBox fx:id="urlOptions" managed="false" spacing="10.0" visible="false">
        <HBox alignment="CENTER" spacing="10.0">
            <MFXTextField fx:id="urlField"/>
        </HBox>
    </VBox>

    <!-- Base de datos -->
    <HBox alignment="CENTER" spacing="10.0">
        <MFXTextField fx:id="databaseField"/>
    </HBox>
    <Separator />

    <!-- Autenticación -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label style="-fx-font-weight: bold;" text="Autenticación" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <MFXTextField fx:id="usernameField"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <MFXPasswordField fx:id="passwordField"/>
    </HBox>

    <!-- No sé si quitar esto xddddddddddd
    <MFXCheckbox fx:id="savePasswordCheck" text="Guardar contraseña" />
    -->
    <!-- Botones -->
    <HBox alignment="CENTER" spacing="20.0">
        <MFXButton fx:id="guardarButton" onAction="#guardarConfiguracion" text="Guardar" />
        <MFXButton fx:id="regresarBoton" onAction="#regresarInicioSesion" text="Regresar" />
    </HBox>
</VBox>