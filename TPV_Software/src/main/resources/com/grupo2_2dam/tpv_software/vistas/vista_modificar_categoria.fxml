<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grupo2_2dam.tpv_software.controladores.ModificarCategoriaControlador">
    <children>
        <Label fx:id="lblTitulo" text="Modificar Categoría" styleClass="modal-title" />

        <VBox spacing="15.0">
            <MFXTextField fx:id="txtNombre" floatingText="Nuevo nombre de la categoría" prefWidth="300.0" />
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <MFXButton fx:id="btnSeleccionarImagen" onAction="#seleccionarImagen" text="Cambiar imagen" styleClass="mfx-button-secundario" />
                <ImageView fx:id="imgVistaPrevia" fitHeight="60" fitWidth="60" preserveRatio="true" />
            </HBox>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <MFXButton fx:id="btnCancelar" onAction="#cerrarVentana" text="Cancelar" styleClass="btn-cancelar" />
            <MFXButton fx:id="btnGuardar" onAction="#guardarCambios" text="Guardar Cambios" styleClass="btn-guardar" />
        </HBox>
    </children>
</VBox>