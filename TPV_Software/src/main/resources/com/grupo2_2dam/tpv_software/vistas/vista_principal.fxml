<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<BorderPane minHeight="600.0" minWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grupo2_2dam.tpv_software.controladores.VistaPrincipalControlador">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="30.0" styleClass="sidebar">
            <padding><Insets bottom="20.0" top="40.0" /></padding>
            <!-- Foto de perfil -->
            <StackPane alignment="CENTER">
                <ImageView fitWidth="90" fitHeight="90" preserveRatio="true" fx:id="foto_de_perfil">
                    <clip>
                        <Circle radius="45" centerX="45" centerY="45"/>
                    </clip>
                </ImageView>
                <Circle radius="45" styleClass="avatar-border" />
            </StackPane>

            <!-- Nombre de usuario -->
            <Label fx:id="nombre_Usuario" styleClass="username-label" text="Usuario" />

            <!--Botones de Gestión -->
            <VBox spacing="10.0" alignment="CENTER">
                <padding><Insets left="20.0" right="20.0" /></padding>
                <Label text="Gestión" styleClass="section-subtitle" />

                <MFXButton fx:id="btnAnadir" text="Añadir Categoría" onAction="#handleAdd"
                           maxWidth="Infinity" styleClass="mfx-button-admin" />

                <MFXButton fx:id="btnModificar" text="Modificar Categoría" onAction="#handleModificar"
                           maxWidth="Infinity" styleClass="mfx-button-admin" />

                <MFXButton fx:id="btnEliminar" text="Eliminar Categoría" onAction="#handleEliminar"
                           maxWidth="Infinity" styleClass="mfx-button-admin-delete" />
            </VBox>

            <MFXScrollPane focusTraversable="false" prefHeight="318.0" prefWidth="250.0" />
            <MFXButton fx:id="regresarButton" alignment="CENTER" onAction="#cerrar_sesion" styleClass="mfx-button, logout-button" text="⬅️" />
        </VBox>
    </left>

    <center>
        <VBox spacing="15.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <Label styleClass="section-title" text="Categorías y Productos" />

            <ScrollPane fitToWidth="true" styleClass="custom-scroll-pane">
                <FlowPane fx:id="flowProductos" hgap="15.0" prefWrapLength="600.0" vgap="15.0">

                    <!--Botones originales-->
                    <!--
                    <MFXButton prefHeight="120.0" prefWidth="150.0" styleClass="mfx-button-categoria" text="Categoria" />
                    <MFXButton prefHeight="120.0" prefWidth="150.0" styleClass="mfx-button-producto" text="Poducto" />
                    -->

                    <!--Comento los ejemplos para mostrar lo guardado en la BD-->
                    <!-- Ejemplos de Categoría
                    <MFXButton prefHeight="120.0" prefWidth="150.0" styleClass="mfx-button-categoria">
                        <graphic>
                            <ImageView fitWidth="70" fitHeight="70" preserveRatio="true" fx:id="foto_categoria"/>
                        </graphic>
                        <text>Frutas y verduras</text>
                    </MFXButton>

                     Ejemplo de productos
                    <MFXButton prefHeight="120.0" prefWidth="150.0" styleClass="mfx-button-producto" contentDisplay="TOP">
                        <graphic>
                            <ImageView fitWidth="70" fitHeight="70" preserveRatio="true" fx:id="foto_mango"/>
                        </graphic>
                        <text>Mango</text>
                    </MFXButton>
                    -->
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="320.0" spacing="15.0" styleClass="summary-pane">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Resumen de Venta" /> <!-- Nota: este Label aún tiene estilo inline, se arreglará abajo -->
            <VBox styleClass="summary-content" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Label text="Subtotal:" />
                <Label styleClass="subtotal-label" text="0.00 €" />
            </HBox>
            <MFXButton maxWidth="Infinity" prefHeight="55.0" styleClass="mfx-button-pagar" text="Pagar" />
        </VBox>
    </right>
</BorderPane>
