<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="main-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grupo2_2dam.tpv_software.controladores.VistaPagoControlador">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Resumen de Compra" textFill="#512da8">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0; -fx-padding: 2;">
                    <children>
                        <ScrollPane fitToWidth="true" prefHeight="350.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <content>
                                <VBox fx:id="vboxProductos" spacing="5.0" style="-fx-background-color: transparent;">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                    <children>
                        <Label text="TOTAL:">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotal" text="0.00 €" textFill="#2e7d32">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <MFXButton onAction="#finalizarVentaGenerarPDF" prefHeight="55.0" prefWidth="250.0" styleClass="mfx-button-pagar" text="Finalizar y Generar Factura" />
                        <MFXButton fx:id="btnVolver" onAction="#volverAlTPV" prefHeight="55.0" prefWidth="150.0" styleClass="mfx-button-eliminar" text="Volver" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="100.0" right="100.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>